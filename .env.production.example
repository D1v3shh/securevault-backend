# ====================================================
# SecureVault - Environment Configuration
# ====================================================
# Copy from .env.example and fill in your own values.
# NEVER commit this file to version control.
# ====================================================

# Application
NODE_ENV=development
APP_NAME=SecureVault
APP_PORT=3000
APP_HOST=0.0.0.0
API_PREFIX=api/v1
APP_CORS_ORIGINS=http://localhost:3000

# Database - MongoDB
MONGODB_URI=mongodb://securevault_user:securevault_pass_dev@localhost:27017/securevault?authSource=admin
MONGODB_DB_NAME=securevault

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=securevault_redis_dev
REDIS_DB=0
REDIS_KEY_PREFIX=sv:

# JWT (Generate your own secrets — MUST be at least 32 characters)
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=f4c0966d0337e60d311ad375e870e0b1e0633e82d27e1ae42fcc52f38fc3ce81
JWT_ACCESS_EXPIRATION=24h
JWT_REFRESH_SECRET=fa5a979fa72b7977e168aab4b75111ff1501b357fd216c19c811465209505bb2
JWT_REFRESH_EXPIRATION=7d

# HashiCorp Vault
VAULT_ENABLED=true
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dev-root-token
VAULT_MOUNT_PATH=secret
VAULT_SECRETS_PATH=securevault
VAULT_TRANSIT_ENGINE=transit
VAULT_RETRY_ATTEMPTS=3
VAULT_RETRY_DELAY_MS=1000

# HashiCorp Vault PKI
VAULT_PKI_PATH=pki_int
VAULT_PKI_ROLE=securevault-device

# Storage
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./storage/uploads
STORAGE_TEMP_PATH=./storage/temp
STORAGE_MAX_FILE_SIZE=104857600

# Encryption
ENCRYPTION_ALGORITHM=aes-256-gcm
ENCRYPTION_KEY_LENGTH=32
ENCRYPTION_IV_LENGTH=16
ENCRYPTION_AUTH_TAG_LENGTH=16

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_TTL=60
RATE_LIMIT_AUTH_MAX=10

# Logging
LOG_LEVEL=debug
LOG_DIR=./logs

# Super Admin Seed (created automatically on first startup)
SEED_SUPER_ADMIN_EMAIL=kumavatdivesh671@gmail.com   
SEED_SUPER_ADMIN_PASSWORD=DiKu@671
SEED_SUPER_ADMIN_FIRST_NAME=Divesh
SEED_SUPER_ADMIN_LAST_NAME=Kumawat

# BullMQ
BULL_QUEUE_PREFIX=sv-queue
